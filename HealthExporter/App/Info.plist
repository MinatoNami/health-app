<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Health Exporter</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Read-only exporter, so only the share (read) purpose string is present.
	     NSHealthUpdateUsageDescription is deliberately omitted: fewer
	     permissions to justify, and nothing here writes to HealthKit.
	     A missing share string does not degrade gracefully — the app crashes
	     when requestAuthorization is called. -->
	<key>NSHealthShareUsageDescription</key>
	<string>Health Exporter reads your activity, sleep, vitals, body, and nutrition data so it can be exported to your own server or a file you control. Nothing is sent anywhere you have not configured.</string>

	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>

	<!-- Must list every identifier passed to BGTaskScheduler, or submit() throws. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.lionelchong.HealthExporter.sync</string>
		<string>com.lionelchong.HealthExporter.refresh</string>
	</array>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Batches are plain files in Documents so they can be retrieved through the
	     Files app without going via the share sheet. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
