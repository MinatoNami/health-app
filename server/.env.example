# Copy to .env on the server. The deploy script generates this on first run.
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=alena-server.tail03bec9.ts.net,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://alena-server.tail03bec9.ts.net
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=health
POSTGRES_USER=health
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Where health summaries get explained. LM Studio runs on a laptop, not on this
# host, so this must be the laptop's MagicDNS name — reached over the tailnet.
#
# 127.0.0.1 here would mean the *container*, and a bare tailnet IP returns 404
# because `tailscale serve` routes by Host header. Set it with:
#     ./deploy.sh llm http://<machine>.<tailnet>.ts.net:1234/v1
#
# On the machine running LM Studio, publish it to the tailnet only:
#     tailscale serve --bg --http=1234 http://127.0.0.1:1234
LLM_BASE_URL=http://macbook-pro-m5-max.tail03bec9.ts.net:1234/v1
LLM_ENABLED=1
# Optional: pin a specific model. Left unset, the first chat model the server
# has loaded is used, which is usually what you want on a laptop.
# LLM_MODEL=qwen/qwen3.6-35b-a3b
LLM_TIMEOUT_SECONDS=180
# How long questions and answers are kept before deletion. Chats are made of
# those, so this bounds the chat history too — the sidebar says so out loud, and
# emptied chats are removed with their messages.
INSIGHT_RETENTION_DAYS=30
# How many earlier turns of a conversation are replayed for continuity. Only
# their summaries, never the evidence. Raise it if the model behind LLM_BASE_URL
# has room; the snapshot has to keep dominating the context, so this is capped
# at 20 whatever you put here.
INSIGHT_HISTORY_TURNS=6
# What the model behind LLM_BASE_URL can hold. Normally leave this unset: LM
# Studio reports the loaded model's context length and the server asks, so this
# stays correct when you swap models. Set it only to work in a smaller window
# than the model technically has — an explicit value always wins.
#
# When a chat's replayed history would not fit, the older turns are summarised
# into the session and replaced by that summary. The transcript is never changed.
# LLM_CONTEXT_TOKENS=8192
